{
  "name": "agent-foundry",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "smoke": "tsx tests/smoke.ts",
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "verify": "npm run runtime:check && npm run format:check && npm run lint && npm run typecheck && npm test && npm run smoke",
    "runtime:check": "node scripts/check-runtime.mjs"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "tsx": "^4.20.5",
    "@types/node": "^22.18.0",
    "prettier": "^3.6.2",
    "eslint": "^9.34.0",
    "@eslint/js": "^9.34.0",
    "typescript-eslint": "^8.40.0",
    "globals": "^16.3.0"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
